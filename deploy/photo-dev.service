# 放到 /etc/systemd/system/photo-dev.service（测试环境后端，端口 8081）
[Unit]
Description=Sheyinglai photo server (test)
After=network.target mysql.service
Wants=mysql.service

[Service]
User=photo
WorkingDirectory=/srv/photo-dev
EnvironmentFile=/srv/photo-dev/photo.env
ExecStart=/usr/bin/java -Duser.timezone=Asia/Shanghai -Xms128m -Xmx384m -jar /srv/photo-dev/app.jar --spring.profiles.active=test
SuccessExitStatus=143
Restart=always
RestartSec=5
# 基础加固：不能提权，系统目录只读，独立 /tmp
NoNewPrivileges=true
ProtectSystem=full
PrivateTmp=true

[Install]
WantedBy=multi-user.target
