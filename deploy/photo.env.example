# 复制为 /srv/photo/photo.env 并修改；chmod 600，不要提交到 Git
DB_URL=jdbc:mysql://127.0.0.1:3306/photo?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai
DB_USERNAME=photo
DB_PASSWORD=改成一个强密码

ADMIN_USERNAME=admin
ADMIN_PASSWORD=改成你的后台登录密码

# local：图片存服务器磁盘 /srv/photo/uploads；oss：存阿里云 OSS
STORAGE_TYPE=local
# 以下仅 STORAGE_TYPE=oss 时需要（服务器和 Bucket 同在上海时 endpoint 用内网地址免流量费）
OSS_ENDPOINT=https://oss-cn-shanghai-internal.aliyuncs.com
OSS_BUCKET=
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_DOMAIN=https://你的bucket.oss-cn-shanghai.aliyuncs.com
