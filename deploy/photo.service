# 放到 /etc/systemd/system/photo.service
[Unit]
Description=Sheyinglai photo server
After=network.target mysql.service
Wants=mysql.service

[Service]
User=photo
WorkingDirectory=/srv/photo
EnvironmentFile=/srv/photo/photo.env
ExecStart=/usr/bin/java -Duser.timezone=Asia/Shanghai -Xms256m -Xmx768m -jar /srv/photo/app.jar --spring.profiles.active=prod
SuccessExitStatus=143
Restart=always
RestartSec=5
# 基础加固：不能提权，系统目录只读，独立 /tmp
NoNewPrivileges=true
ProtectSystem=full
PrivateTmp=true

[Install]
WantedBy=multi-user.target
