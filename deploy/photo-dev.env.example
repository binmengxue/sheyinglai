# 复制为 /srv/photo-dev/photo.env 并修改；chmod 600，不要提交到 Git
# 测试库和账号要和线上分开，测试进程出问题也碰不到线上数据：
#   CREATE DATABASE photo_dev DEFAULT CHARACTER SET utf8mb4;
#   CREATE USER 'photo_dev'@'localhost' IDENTIFIED BY '另一个强密码';
#   GRANT ALL PRIVILEGES ON photo_dev.* TO 'photo_dev'@'localhost';
DB_URL=jdbc:mysql://127.0.0.1:3306/photo_dev?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai
DB_USERNAME=photo_dev
DB_PASSWORD=和线上不同的强密码

# 管理员用手机号登录；首次启动自动创建，以后改密码只需改这里并重启
ADMIN_PHONE=你的手机号
ADMIN_PASSWORD=测试环境后台登录密码

# 测试环境图片默认存 /srv/photo-dev/uploads，和线上互不影响
STORAGE_TYPE=local
